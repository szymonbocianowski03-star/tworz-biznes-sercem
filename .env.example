SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR1aWV3dWppZXR0ZmZvZmRlam9yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxNDUyNzIsImV4cCI6MjA5MjcyMTI3Mn0.p_wWV9PpHrhSZ1HjxSVgiOPiHiBtbZenBWDSXPJDUH0
# Wymagane do logowania Google lokalnie (serwer tworzy sesję Supabase):
# SUPABASE_SERVICE_ROLE_KEY=

# Publiczny adres podglądu aplikacji — na localhost umożliwia logowanie Google przez broker OAuth:
# VITE_LOVABLE_APP_URL=https://twoja-domena.app

# CAMPAIGN_COMPOSER_DRY_RUN=false   # ustaw true tylko do testów bez wysyłki na Meta/TikTok
# CAMPAIGN_LAUNCH_WORKER_SECRET=wygeneruj-długi-sekret

# TikTok Ads (TikTok for Business): https://business-api.tiktok.com/portal/docs
# TIKTOK_APP_ID=1234567890          # NUMERYCZNY App ID (nie Client Key)
# TIKTOK_APP_SECRET=
# TIKTOK_REDIRECT_URI=https://twoja-domena.app/api/public/tiktok/callback
# Localhost:
# TIKTOK_REDIRECT_URI=http://localhost:8080/api/public/tiktok/callback

# Supabase Edge Function „generate-video”: Higgsfield API
# Ustaw jako sekrety Edge Function w Supabase Dashboard → Edge Functions → Secrets:
# HIGGSFIELD_API_KEY_ID=''
# HIGGSFIELD_API_SECRET=''
# HIGGSFIELD_API_BASE_URL='https://platform.higgsfield.ai'
# (alternatywnie: HF_CREDENTIALS=KEY_ID:SECRET)
# Nigdy nie commituj prawdziwych kluczy — tylko w sekretach chmury lub lokalnym .env (gitignored).

# --- Integracje OAuth (serwer — bez prefiksu VITE_, ładowane przez TanStack Start / Wrangler) ---
# Meta (Facebook / Instagram / Meta Ads): https://developers.facebook.com/apps/
# W aplikacji Meta → Facebook Login → Valid OAuth Redirect URIs:
#   http://localhost:8081/api/public/meta/callback
#   https://TWOJA-DOMENA/api/public/meta/callback
# META_APP_ID=
# META_APP_SECRET=
# META_FB_LOGIN_CONFIG_ID=  # opcjonalnie: config_id z Meta Login Button (Facebook Login for Business)

# LinkedIn Ads: https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Google (logowanie + Gmail / Kalendarz): https://console.cloud.google.com/apis/credentials
# UWAGA: zmienne z panelu hostingu (Settings → Environment) działają tylko na publicznym podglądzie.
# Do localhost skopiuj te same wartości tutaj (plik .env — nie commituj):
# OAuth 2.0 Client → Authorized redirect URIs — dodaj OBA (ten sam host co publiczny podgląd):
#   https://twoja-domena.app/api/public/auth/google/callback   (logowanie + Gmail + Kalendarz)
#   https://twoja-domena.app/api/public/google/callback        (opcjonalnie — legacy)
# Localhost:
#   http://localhost:8080/api/public/auth/google/callback
#   http://localhost:8080/api/public/google/callback
# Opcjonalnie wymuś jeden adres:
# GOOGLE_OAUTH_REDIRECT_URI=https://twoja-domena.app/api/public/auth/google/callback
# Włącz też API: Google Calendar API (console.cloud.google.com/apis/library)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
